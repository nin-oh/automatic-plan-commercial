# Plan Commercial — Docker Compose configuration template.
#
# Copy this file to `.env` next to docker-compose.yml and edit the values.
# Compose auto-loads `.env` on every `docker compose` command — no need to
# pass it as an argument.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# `.env` is git-ignored so secrets and per-host paths stay out of commits.

# ─── Where deck data lives on the HOST ────────────────────────────────────
# Two valid forms:
#
#   1. A named Docker volume (default): managed by Docker, opaque to you,
#      survives `docker compose down` but not `docker compose down -v`.
#         PC_DATA_HOST=pc_data
#
#   2. A path on your host filesystem: browsable, easy to back up by
#      copying the folder, can be a network share. Use forward slashes
#      even on Windows.
#         PC_DATA_HOST=D:/plan_commercial_data            (Windows)
#         PC_DATA_HOST=/var/lib/plan-commercial           (Linux)
#         PC_DATA_HOST=/Users/me/plan-commercial-data     (macOS)
#
# The folder must exist *before* `docker compose up` if you go with form 2.
PC_DATA_HOST=pc_data

# ─── Where the container expects to find data INSIDE itself ───────────────
# You almost never need to change this. The container's session.py reads
# PC_DATA_DIR and uses it as the root for state.db + images/ + archive/.
PC_DATA_DIR=/app/data
